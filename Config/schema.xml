<?xml version="1.0" encoding="UTF-8"?>
<database defaultIdMethod="native" name="TheliaMain"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="../../../../core/vendor/propel/propel/resources/xsd/database.xsd" >

  <table name="top_product" namespace="TopProducts\Model">
    <column name="id" type="INTEGER" required="true" primaryKey="true" autoIncrement="true" />
    <column name="element_key" type="VARCHAR" size="255" />
    <column name="element_id" type="INTEGER" />
    <column name="product_id" type="INTEGER" />
    <column name="selection_code" type="VARCHAR" size="255" />
    <column name="position" type="INTEGER" />

    <foreign-key foreignTable="product" phpName="Product">
      <reference local="product_id" foreign="id" />
    </foreign-key>
  </table>
  <external-schema filename="local/config/schema.xml" referenceOnly="true" />
</database>
